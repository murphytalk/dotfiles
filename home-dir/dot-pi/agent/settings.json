{
  "lastChangelogVersion": "1.0.2",
  "defaultProvider": "freellm",
  "defaultModel": "auto",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:pi-nvidia-nim",
    "npm:pi-ultra-compact",
    "npm:pi-alibaba-models",
    "git:github.com/fengfanfan-max/pi-agent-backup-migrate",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "model": "alibaba-cloud/qwen3.7-plus",
        "thinking": "high"
      },
      "oracle": {
        "model": "deepseek/deepseek-v4-pro",
        "thinking": "high"
      },
      "delegate": {
        "model": "moonshotai-cn/kimi-k3",
        "thinking": "high"
      },
      "researcher": {
        "model": "alibaba-cloud/qwen3.7-flash",
        "thinking": "medium"
      },
      "worker": {
        "model": "deepseek/deepseek-flash",
        "thinking": "medium"
      },
      "scout": {
        "model": "freellm/auto",
        "thinking": "low"
      }
    }
  },
  "theme": "dark"
}
